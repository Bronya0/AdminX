SECRET_KEY=django-insecure-xxx-change-in-production
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://127.0.0.1:6379/0
JWT_ACCESS_EXPIRE=30
JWT_REFRESH_EXPIRE=7
THROTTLE_ANON=30/minute
THROTTLE_USER=200/minute
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CAPTCHA_ENABLED=False
# FERNET_KEY=xxx  # 配置中心加密存储密钥，用于 is_encrypted=True 的配置项。生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"