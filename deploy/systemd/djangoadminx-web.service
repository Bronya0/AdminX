[Unit]
Description=DjangoAdminX Web (Gunicorn)
After=network.target postgresql.service redis.service
Requires=postgresql.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/path/to/DjangoAdminX
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
Environment=PYTHONUNBUFFERED=1
ExecStart=/path/to/DjangoAdminX/.venv/bin/gunicorn config.wsgi:application \
    --workers 4 \
    --bind 0.0.0.0:8000 \
    --timeout 120 \
    --access-logfile /var/log/djangoadminx/access.log \
    --error-logfile /var/log/djangoadminx/error.log \
    --pid /run/djangoadminx/pid
ExecReload=/bin/kill -s HUP $MAINPID
RuntimeDirectory=djangoadminx
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
