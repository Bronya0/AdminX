[Unit]
Description=AdminX Gunicorn
After=network.target redis.target postgresql.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/app
ExecStart=/app/.venv/bin/gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 4 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target