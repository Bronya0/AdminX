[Unit]
Description=DjangoAdminX Scheduler (APScheduler)
After=network.target postgresql.service djangoadminx-web.service
Requires=djangoadminx-web.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/path/to/DjangoAdminX
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
Environment=PYTHONUNBUFFERED=1
ExecStart=/path/to/DjangoAdminX/.venv/bin/python manage.py run_scheduler
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
